{
  "schemaVersion": 2,
  "slug": "orcha-discord-agent",
  "name": "Discord AI Agent",
  "description": "A production-ready Discord assistant with an OrchaJS runtime and Next.js test console.",
  "category": "discord-agent",
  "tags": ["discord", "slash-commands", "bot", "streaming"],
  "repository": {
    "host": "github",
    "owner": "Amarsia",
    "name": "orcha-discord-agent-template",
    "template": true
  },
  "stack": {
    "framework": "nextjs",
    "node": ">=20.9.0"
  },
  "agent": {
    "entrypoint": "orcha/index.ts",
    "defaultAgent": "assistant"
  },
  "customization": {
    "productConfig": ["config/bot.ts"],
    "agent": [
      "orcha/assistant/index.json",
      "orcha/assistant/instructions.md"
    ],
    "theme": ["app/globals.css"],
    "integrations": ["discord/commands.ts"],
    "assets": ["public/**"]
  },
  "environment": {
    "variables": [
      {
        "key": "OPENAI_API_KEY",
        "label": "OpenAI API key",
        "required": true,
        "secret": true,
        "managedByAmarsia": true
      },
      {
        "key": "DISCORD_TOKEN",
        "label": "Discord bot token",
        "required": true,
        "secret": true
      },
      {
        "key": "DISCORD_CLIENT_ID",
        "label": "Discord application ID",
        "required": true,
        "secret": false
      },
      {
        "key": "DISCORD_GUILD_ID",
        "label": "Discord development guild ID",
        "required": false,
        "secret": false
      },
      {
        "key": "VISITOR_COOKIE_SECRET",
        "label": "Web visitor cookie secret",
        "required": true,
        "secret": true,
        "generated": true,
        "minLength": 32
      },
      {
        "key": "AMARSIA_PROJECT_KEY",
        "label": "Amarsia project key",
        "required": false,
        "secret": true,
        "managedByAmarsia": true
      },
      {
        "key": "AMARSIA_API_URL",
        "label": "Amarsia API URL",
        "required": false,
        "secret": false,
        "default": "https://api.amarsia.com"
      },
      {
        "key": "ORCHA_SESSION_DIRECTORY",
        "label": "Session storage directory",
        "required": false,
        "secret": false,
        "default": "/data/sessions"
      }
    ]
  },
  "validation": {
    "commands": [
      { "id": "lint", "run": "npm run lint" },
      { "id": "typecheck", "run": "npm run typecheck" },
      { "id": "agent-test", "run": "npm run agent:test" }
    ],
    "preDeploy": [
      { "id": "discord-register", "run": "npm run discord:register" }
    ]
  },
  "deployment": {
    "type": "container",
    "dockerfile": "Dockerfile",
    "port": 3000,
    "healthcheck": "/",
    "productionCommand": ["npm", "start"],
    "processes": [
      { "id": "web", "role": "http" },
      { "id": "discord-worker", "role": "integration" }
    ],
    "persistentStorage": {
      "path": "/data/sessions",
      "environmentVariable": "ORCHA_SESSION_DIRECTORY",
      "required": true,
      "singleInstance": true
    }
  }
}
