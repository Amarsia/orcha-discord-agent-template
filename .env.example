# Required: AI provider
OPENAI_API_KEY=

# Required: Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: use guild registration while developing for instant command updates.
# Omit for global command registration (which can take up to one hour).
DISCORD_GUILD_ID=

# Durable local storage
ORCHA_SESSION_DIRECTORY=.orcha/sessions

# Required in production: at least 32 random characters
VISITOR_COOKIE_SECRET=

# Optional Amarsia project sync
AMARSIA_PROJECT_KEY=
AMARSIA_API_URL=https://api.amarsia.com
